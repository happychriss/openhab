
Strategies {
    every5Seconds : "0/5 * * * * ?"
    every5Minutes : "0 */5 * * * ?"
    every15Minutes : "0 */15 * * * ?"    
    everyMinute : "0 * * * * ?"
    everyHour   : "0 0 * * * ?"
    everyDay    : "0 0 0 * * ?"
}

Items {
    // Sampled every 5 minutes. openHAB 5 dropped "default =" from Strategies (it failed to parse
    // since August 2026 and JDBC recorded nothing); each item names its strategy explicitly.
    arbeitszimmer_toggle,
    Temperature_Draussen_sonoff,
    Temperature_Arbeitszimmer_sonoff,
    Radiator_Arbeitszimmer_Temperature,
    Radiator_Arbeitszimmer_ActualTemp,
    Radiator_Arbeitszimmer_SetTemp,
    Radiator_Arbeitszimmer_RadiatorMode,
    localCurrentTemperature,
    localCurrentTemperature_2h,
    CNOut
     : strategy = every5Minutes
}
