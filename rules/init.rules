// Runs at startup - and again whenever openHAB reloads items/rules files.
// So only fill items that have no value yet; never switch things that already have a state.
// SunIsDown: set from astro sun phase (absence.rules)
rule "Init"
when
	System started
then
 if (AbsenceMode.state == NULL) sendCommand(AbsenceMode,OFF)
 // at startup: I am home
 if (CNOut.state == NULL) sendCommand(CNOut,OFF)
 if (ANOut.state == NULL) sendCommand(ANOut,OFF)
 // coffee machine: its off-timer is lost on restart -> switch off for safety
 sendCommand(Conbee_PlugOnOff_Kitchen_Coffee,OFF)
end
