var Timer TimerOutAN = null
var Timer TimerOutCN = null

// FRITZ!Box WiFi presence: ON = home, OFF = start 45min timer, then really out.
// UNDEF/NULL = FRITZ!Box did not answer -> keep current state and a running timer.

rule "Absence Christian!"
when
    Item cFboxMacOnline_cn changed
then

//OPEN - I am home
    if (cFboxMacOnline_cn.state==ON)
    {
        if(TimerOutCN !== null) {
           TimerOutCN.cancel()
           TimerOutCN = null
        }
        logInfo("absence_check_wifi", "CN is here")
        sendCommand(CNOut,OFF)
    }
    else if (cFboxMacOnline_cn.state==OFF) {
//CLOSED - I am out, if more then x-min, I am really out
        if(TimerOutCN !== null) {
           TimerOutCN.cancel()
           TimerOutCN = null
        }
        logInfo("absence_check_wifi", "CN is not here, start timer")
        TimerOutCN = createTimer(now.plusMinutes(45))[|
                logInfo("absence_check_wifi", "CN is not here, timer finished, really out")
                sendCommand(CNOut,ON)
                TimerOutCN = null
            ]
    }
    else {
        logInfo("absence_check_wifi", "CN presence unknown (" + cFboxMacOnline_cn.state + "), FRITZ!Box not answering - no change")
    }
end


rule "Absence Anne"
when
    Item cFboxMacOnline_an changed
then

//OPEN - I am home
    if (cFboxMacOnline_an.state==ON)
    {
        if(TimerOutAN !== null) {
           TimerOutAN.cancel()
           TimerOutAN = null
        }
        logInfo("absence_check_wifi", "Anne is here")
        sendCommand(ANOut,OFF)
    }
    else if (cFboxMacOnline_an.state==OFF) {
//CLOSED - I am out, if more then x-min, I am really out
        if(TimerOutAN !== null) {
           TimerOutAN.cancel()
           TimerOutAN = null
        }
        logInfo("absence_check_wifi", "Anne is not here, start timer")
        TimerOutAN = createTimer(now.plusMinutes(45))[|
                logInfo("absence_check_wifi", "Anne is not here, timer finished, really out")
                sendCommand(ANOut,ON)
                TimerOutAN = null
            ]
    }
    else {
        logInfo("absence_check_wifi", "Anne presence unknown (" + cFboxMacOnline_an.state + "), FRITZ!Box not answering - no change")
    }
end
